# MediWise Backend Configuration
SPRING_PROFILES_ACTIVE=prod

# ─── Default Seeded Accounts (Reference) ───────────────────────────
# Admin:  admin@mediwise.com     | Password: Admin@12345
# Doctor: dr.sarah@mediwise.com   | Password: Doctor@12345
# Doctor: dr.rajesh@mediwise.com  | Password: Doctor@12345

# Database (PostgreSQL)
DB_USERNAME=clinical_user
DB_PASSWORD=clinical_secure_password_change_me
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/clinical_db

# MongoDB
MONGODB_URI=mongodb://mongo:27017/clinical_chat

# Redis
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379

# Security (JWT)
# Local profile: set a random Base64 secret with at least 32 decoded bytes.
# Example: openssl rand -base64 32
JWT_SECRET=
# Production profile: AWS Secrets Manager secret name.
JWT_SECRET_NAME=mediwise/prod/jwt
APPLICATION_JWT_EXPIRATION=86400000
APPLICATION_JWT_REFRESH_EXPIRATION=604800000

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_key
RAZORPAY_KEY_SECRET=rzp_test_secret
RAZORPAY_WEBHOOK_SECRET=webhook_secret

# Cloud Storage (AWS S3 in production; local MinIO for dev — see docker-compose.yml's
# `minio` service). For local dev, leave S3_ENDPOINT set so the app talks to MinIO
# instead of real AWS, and point S3_BASE_URL at a LAN-reachable address (matching
# DEBUG_BASE_URL in the Android build) so the app can actually load uploaded files —
# for production, leave S3_ENDPOINT blank and S3_BASE_URL empty to use AWS's default.
AWS_ACCESS_KEY=minioadmin
AWS_SECRET_KEY=minioadmin123
AWS_REGION=ap-south-1
S3_BUCKET=clinical-system-files
S3_ENDPOINT=http://minio:9000
S3_BASE_URL=

# AI Symptom Triage (Google Gemini)
# Without this set, AI triage falls back to a safe generic response instead of failing.
GEMINI_API_KEY=
